// =============================================================================
// Modalin - Entity Relationship Diagram
// =============================================================================
// SATU-SATUNYA SUMBER KEBENARAN untuk skema database Modalin.
// `apps/api/prisma/schema.prisma` diturunkan dari file ini, bukan sebaliknya.
// Kalau file ini berubah: (1) selaraskan schema.prisma, (2) buat migration,
// (3) generate ulang gambar ERD lewat https://dbdiagram.io.
//
// Acuan: specs/ARCHITECTURE.md §5, proposal HOLOGY 9.0 §3.1.4.
//
// -----------------------------------------------------------------------------
// CATATAN PENYIMPANGAN dari ARCHITECTURE.md §5 (wajib dicatat, jangan diam-diam)
// -----------------------------------------------------------------------------
// 1. 14 tabel, bukan 13. Tambahan `Transaction` untuk FR-13 (checkout simulasi
//    biaya layanan + langganan Modalin Pro). ARCHITECTURE.md §5 menyebut 13
//    tabel karena ditulis sebelum FR-13 dipetakan ke tabel sendiri.
//
// 2. 8 enum, bukan 3. ARCHITECTURE.md §5 menyebut 3 enum (role, connection,
//    funding). Lima tambahan dipakai karena aturan bisnisnya adalah state
//    machine yang harus dijaga di level basis data, bukan string bebas:
//      - verification_status : gerbang badge Terverifikasi (FR-02)
//      - cooperation_type    : kunci hard filter irisan (FR-06)
//      - agreement_status    : gerbang terbit PDF (FR-10/FR-11)
//      - transaction_type    : pisahkan biaya layanan vs langganan (FR-13)
//      - transaction_status  : hasil checkout simulasi (FR-13)
//
// 3. `cooperationTypes` disimpan sebagai JSON array of enum, BUKAN kolom
//    tunggal. Alasan: FR-06 mensyaratkan "irisan" (intersection), dan layar
//    stitch `edit_profil_usaha_jenis_kerja_sama` memakai <input type="checkbox">
//    (multi-pilih). Satu kolom tunggal hanya bisa menyatakan kesamaan, bukan
//    irisan. Alternatif tabel junction ditolak supaya jumlah tabel tetap
//    terkendali. Isi array divalidasi Zod di Application Layer.
//
// 4. Tidak ada tabel `Notification`. FR-09 (indikator in-app) diturunkan dari
//    data yang sudah ada: `Message.readAt IS NULL` untuk pesan belum dibaca,
//    dan `Connection.status` untuk update status koneksi. Menambah tabel hanya
//    untuk indikator dianggap tidak sepadan pada MVP ini.
//
// 5. Riwayat keputusan verifikasi (ARCHITECTURE.md §2.3 "tersimpan untuk
//    audit") disimpan sebagai keputusan TERAKHIR di Profile
//    (verificationStatus, verifiedAt, verifiedById, rejectReason), bukan log
//    penuh multi-baris. Log penuh butuh tabel ke-15; ditunda pasca-penyisihan.
//
// 6. Menutup Keputusan Terbuka ARCHITECTURE.md §12 poin 1 ("field spesifik per
//    jenis kerja sama"): Agreement kini punya kolom skema-spesifik nullable
//    (profitSharingRatio, equityPercentage, interestRate, tenorMonths) alih-alih
//    field generik untuk ketiga jenis. Hanya kolom yang relevan dengan
//    `cooperationType` yang diisi dan dirender ke template PDF.
// =============================================================================

Project modalin {
  database_type: 'MySQL'
  Note: '''
    Modalin - platform pertemuan UMKM pencari modal dengan investor.
    14 tabel, 8 enum. Diakses lewat Prisma ORM, prinsip ACID dijaga.
    Locale tunggal: Bahasa Indonesia, Rupiah, tanggal Indonesia.
  '''
}

// =============================================================================
// ENUM
// =============================================================================

Enum role {
  UMKM     [note: 'Pengusaha pencari modal']
  INVESTOR [note: 'Pemodal']
  ADMIN    [note: 'Internal, verifikator KYC. Bukan tabel terpisah (ARCHITECTURE.md §1)']
}

Enum verification_status {
  UNVERIFIED [note: 'Belum mengunggah dokumen KYC']
  PENDING    [note: 'Dokumen masuk antrean admin, urut kycSubmittedAt ASC']
  VERIFIED   [note: 'Admin approve. HANYA status ini yang menampilkan badge Terverifikasi (FR-02)']
  REJECTED   [note: 'Admin reject, wajib isi rejectReason. User boleh unggah ulang -> balik ke PENDING']
}

Enum connection_status {
  PENDING  [note: 'Pengirim membuat permintaan ketertarikan']
  ACCEPTED [note: 'Penerima menyetujui. Membuka Conversation + alur Agreement']
  REJECTED [note: 'Penerima menolak. Berarti TIDAK PERNAH diterima. Terminal.']
  CLOSED   [note: 'Pernah ACCEPTED lalu diakhiri salah satu pihak. Terminal.']
}

Enum funding_status {
  DRAFT
  ACTIVE      [note: 'Tampil di pencarian dan matchmaking']
  NEGOTIATION [note: 'Ada Connection ACCEPTED yang sedang berjalan']
  FUNDED
  COMPLETED   [note: 'Prasyarat rating (FR-12)']
  CANCELLED
}

Enum cooperation_type {
  BAGI_HASIL        [note: 'Bagi Hasil']
  PENYERTAAN_MODAL  [note: 'Penyertaan Modal']
  PINJAMAN          [note: 'Pinjaman']
}

Enum agreement_status {
  DRAFT             [note: 'Form kesepakatan diisi, belum ada tanda tangan']
  WAITING_SIGNATURE [note: 'Baru 1 dari 2 pihak tanda tangan. Generate PDF DITOLAK di sini (FR-10)']
  SIGNED            [note: '2 tanda tangan lengkap. PDF final boleh terbit (FR-11)']
  ACTIVE            [note: 'Kerja sama berjalan']
  COMPLETED         [note: 'Selesai. Membuka rating (FR-12)']
  CANCELLED
}

Enum transaction_type {
  PLATFORM_FEE     [note: 'Biaya layanan platform']
  SUBSCRIPTION_PRO [note: 'Langganan Modalin Pro']
}

Enum transaction_status {
  PENDING
  SUCCESS [note: 'Simulasi. Babak penyisihan tanpa SDK asli (ARCHITECTURE.md §11)']
  FAILED
}

// =============================================================================
// KELOMPOK 1 - ENTITAS IDENTITAS
// =============================================================================

Table User {
  id           varchar(30) [pk, note: 'cuid']
  email        varchar(254) [not null, unique]
  passwordHash varchar(255) [not null, note: 'Argon2id, BUKAN bcrypt (OWASP, ARCHITECTURE.md §4.3)']
  role         role [not null]
  createdAt    datetime [not null, default: `now()`]
  updatedAt    datetime [not null]

  Note: 'Pusat identitas. Admin dibedakan lewat kolom role, tidak punya tabel sendiri.'
}

Table Profile {
  id       varchar(30) [pk]
  userId   varchar(30) [not null, unique, ref: - User.id]
  fullName varchar(120) [not null]
  phone    varchar(30)
  avatarUrl varchar(500)
  bio      text [note: 'Generik. Untuk INVESTOR dipakai sebagai deskripsi fokus investasi.']
  location varchar(120) [note: 'Dipakai bobot lokasi 10% FR-07']

  // --- FR-02 KYC & verifikasi ---
  ktpUrl             varchar(500) [note: 'Wajib kedua peran']
  nibUrl             varchar(500) [note: 'Wajib khusus UMKM']
  verificationStatus verification_status [not null, default: 'UNVERIFIED']
  kycSubmittedAt     datetime [note: 'Kunci urutan antrean admin (FR-02: antrean urut waktu)']
  verifiedAt         datetime
  verifiedById       varchar(30) [ref: > User.id, note: 'Admin yang memutuskan. Jejak audit keputusan terakhir.']
  rejectReason       varchar(500) [note: 'Wajib diisi saat REJECTED (FR-02: reject 1-klik + alasan)']

  // --- FR-03 Trust Score ---
  trustScore          int [not null, default: 0, note: 'Skala 0-100. Dihitung ulang <5 detik oleh Trust Score Engine.']
  trustScoreUpdatedAt datetime

  indexes {
    (verificationStatus, kycSubmittedAt) [name: 'idx_profile_kyc_queue']
    trustScore [name: 'idx_profile_trust']
  }

  Note: '1:1 dengan User. Badge Terverifikasi HANYA saat verificationStatus = VERIFIED.'
}

// =============================================================================
// KELOMPOK 2 - ENTITAS DATA BISNIS DAN INVESTASI
// =============================================================================

Table Sector {
  id   varchar(30) [pk]
  name varchar(80) [not null, unique, note: 'mis. Kuliner, Kriya, Agrikultur, Fesyen']
  slug varchar(80) [not null, unique]

  Note: 'Dirujuk Business DAN InvestorPreference, supaya bobot sektor 40% (FR-07) punya data dua sisi.'
}

Table Business {
  id              varchar(30) [pk]
  ownerId         varchar(30) [not null, unique, ref: - User.id, note: '1:1 - satu Pengusaha satu profil bisnis']
  name            varchar(150) [not null]
  description     text [not null]
  sectorId        varchar(30) [not null, ref: > Sector.id]
  location        varchar(120) [not null]
  establishedYear int
  employeeCount   int
  monthlyRevenue  decimal(15,2)
  createdAt       datetime [not null, default: `now()`]
  updatedAt       datetime [not null]

  indexes {
    (sectorId, location) [name: 'idx_business_sector_location']
  }
}

Table FundingRequest {
  id               varchar(30) [pk]
  businessId       varchar(30) [not null, ref: > Business.id, note: 'N:1 - satu Business bisa banyak permintaan']
  title            varchar(150) [not null]
  targetAmount     decimal(15,2) [not null, note: 'NILAI TUNGGAL, bukan rentang min-max (ARCHITECTURE.md §5.2)']
  purpose          text [not null]
  cooperationTypes json [not null, note: 'Array cooperation_type, multi-pilih. Sisi UMKM untuk irisan FR-06.']
  tenorMonths      int
  estimatedRoi     decimal(5,2) [note: 'Persen. Ditampilkan di kartu peluang.']
  deadline         datetime
  status           funding_status [not null, default: 'DRAFT']
  createdAt        datetime [not null, default: `now()`]
  updatedAt        datetime [not null]

  indexes {
    (status, createdAt) [name: 'idx_funding_status_created']
    businessId [name: 'idx_funding_business']
  }
}

Table InvestorPreference {
  id                varchar(30) [pk]
  userId            varchar(30) [not null, unique, ref: - User.id, note: '1:1 dengan User role INVESTOR']
  minimumAmount     decimal(15,2) [not null, default: 0, note: 'Bobot modal 30% FR-07']
  maximumAmount     decimal(15,2) [not null, default: 0]
  preferredLocation varchar(120) [note: 'Bobot lokasi 10% FR-07 HANYA dihitung kalau kolom ini terisi']
  preferredSectorId varchar(30) [ref: > Sector.id, note: 'NULLABLE. Ditambahkan supaya bobot sektor 40% FR-07 punya data sisi investor.']
  cooperationTypes  json [not null, note: 'Array cooperation_type, multi-pilih. Sisi investor untuk irisan FR-06.']
  createdAt         datetime [not null, default: `now()`]
  updatedAt         datetime [not null]
}

Table Portfolio {
  id          varchar(30) [pk]
  ownerId     varchar(30) [not null, ref: > User.id]
  title       varchar(150) [not null]
  description text
  fileUrl     varchar(500) [not null, note: 'Cloud Storage. Disimpan terisolasi.']
  fileType    varchar(80) [not null, note: 'MIME. Hanya PDF/gambar (FR-04)']
  fileSize    int [not null, note: 'Byte. Ditolak jika > 10485760 (10MB, FR-04)']
  createdAt   datetime [not null, default: `now()`]

  indexes {
    (ownerId, createdAt) [name: 'idx_portfolio_owner']
  }

  Note: 'GENERIK untuk kedua peran. UMKM: proposal usaha. Investor: rekam jejak investasi. Bukan tabel terpisah per peran.'
}

// =============================================================================
// KELOMPOK 3 - ENTITAS INTERAKSI DAN KESEPAKATAN
// =============================================================================

Table Connection {
  id               varchar(30) [pk]
  senderId         varchar(30) [not null, ref: > User.id]
  receiverId       varchar(30) [not null, ref: > User.id]
  fundingRequestId varchar(30) [ref: > FundingRequest.id]
  status           connection_status [not null, default: 'PENDING']
  message          varchar(500) [note: 'Pesan perkenalan opsional saat kirim ketertarikan']
  respondedAt      datetime
  closedAt         datetime
  closedById       varchar(30) [ref: > User.id, note: 'Siapa yang mengakhiri. CLOSED boleh oleh SALAH SATU pihak.']
  createdAt        datetime [not null, default: `now()`]
  updatedAt        datetime [not null]

  indexes {
    (senderId, receiverId, fundingRequestId) [unique, name: 'uq_connection_pair']
    (receiverId, status) [name: 'idx_connection_inbox']
    (senderId, status) [name: 'idx_connection_outbox']
  }

  Note: '''
    FR-14 state machine:
      PENDING  -> ACCEPTED  (HANYA receiver)
      PENDING  -> REJECTED  (HANYA receiver)
      ACCEPTED -> CLOSED    (sender ATAU receiver)
      REJECTED, CLOSED = terminal, tidak bisa berubah lagi.
    REJECTED != CLOSED. REJECTED artinya tidak pernah diterima.
  '''
}

Table Conversation {
  id           varchar(30) [pk]
  connectionId varchar(30) [not null, unique, ref: - Connection.id]
  createdAt    datetime [not null, default: `now()`]

  Note: '1:1 dengan Connection. Dibuat TEPAT saat Connection jadi ACCEPTED, tidak sebelumnya.'
}

Table Message {
  id             varchar(30) [pk]
  conversationId varchar(30) [not null, ref: > Conversation.id]
  senderId       varchar(30) [not null, ref: > User.id]
  body           text [not null]
  readAt         datetime [note: 'NULL = belum dibaca. Sumber indikator in-app notification FR-09.']
  createdAt      datetime [not null, default: `now()`]

  indexes {
    (conversationId, createdAt) [name: 'idx_message_thread']
    (conversationId, readAt) [name: 'idx_message_unread']
  }

  Note: 'Riwayat permanen (FR-08). Dikelompokkan per Conversation, bukan per pasangan pengirim-penerima tiap baris.'
}

Table Agreement {
  id              varchar(30) [pk]
  connectionId    varchar(30) [not null, ref: > Connection.id]
  agreementNumber varchar(50) [not null, unique, note: 'mis. MLN-2026-000123']
  cooperationType cooperation_type [not null, note: 'Menentukan template dokumen yang dipakai (FR-10)']
  amount          decimal(15,2) [not null]
  startDate       datetime [not null]
  endDate         datetime

  // --- Field skema-spesifik. Menutup Keputusan Terbuka ARCHITECTURE.md §12 poin 1. ---
  profitSharingRatio decimal(5,2) [note: 'Persen bagian investor. HANYA untuk BAGI_HASIL.']
  equityPercentage   decimal(5,2) [note: 'Persen kepemilikan. HANYA untuk PENYERTAAN_MODAL.']
  interestRate       decimal(5,2) [note: 'Persen per tahun. HANYA untuk PINJAMAN.']
  tenorMonths        int [note: 'Untuk PINJAMAN dan BAGI_HASIL berjangka.']

  terms       text [note: 'Klausul tambahan hasil negosiasi']
  status      agreement_status [not null, default: 'DRAFT']
  documentUrl varchar(500) [note: 'PDF final di Cloud Storage. WAJIB NULL selama status != SIGNED (FR-10/FR-11).']
  createdAt   datetime [not null, default: `now()`]
  updatedAt   datetime [not null]

  indexes {
    connectionId [name: 'idx_agreement_connection']
    status [name: 'idx_agreement_status']
  }

  Note: 'FK ke Connection, bukan ke dua User. Kedua pihak ditelusuri lewat koneksinya tanpa duplikasi data.'
}

Table AgreementSignature {
  id           varchar(30) [pk]
  agreementId  varchar(30) [not null, ref: > Agreement.id]
  userId       varchar(30) [not null, ref: > User.id]
  signatureUrl varchar(500) [not null, note: 'Gambar tanda tangan, disimpan terisolasi']
  signedIp     varchar(45) [note: 'Jejak audit. Bukan sertifikasi PSrE.']
  signedAt     datetime [not null, default: `now()`]

  indexes {
    (agreementId, userId) [unique, name: 'uq_signature_per_user']
  }

  Note: '''
    SATU tanda tangan per user per agreement.
    PDF final HANYA terbit kalau COUNT(*) = 2 untuk satu agreementId (FR-10).
    PENTING: tanda tangan ini TIDAK tersertifikasi PSrE. Sah menurut Pasal 11
    UU ITE dan Pasal 59 ayat (3) PP No. 71/2019, tapi JANGAN diklaim setara
    akta notaris (ARCHITECTURE.md §11).
  '''
}

Table Rating {
  id             varchar(30) [pk]
  agreementId    varchar(30) [not null, ref: > Agreement.id]
  reviewerId     varchar(30) [not null, ref: > User.id, note: 'Pemberi rating']
  reviewedUserId varchar(30) [not null, ref: > User.id, note: 'Penerima rating']
  score          int [not null, note: 'Skala 1-5. Divalidasi di Application Layer.']
  review         text
  createdAt      datetime [not null, default: `now()`]

  indexes {
    (agreementId, reviewerId) [unique, name: 'uq_rating_once_per_agreement']
    reviewedUserId [name: 'idx_rating_reviewed']
  }

  Note: 'Hanya boleh dibuat kalau Agreement.status = COMPLETED. Unique key mencegah rating ganda (FR-12). Memicu recompute Trust Score.'
}

// =============================================================================
// KELOMPOK 4 - PEMBAYARAN (FR-13)
// =============================================================================

Table Transaction {
  id            varchar(30) [pk]
  userId        varchar(30) [not null, ref: > User.id]
  type          transaction_type [not null]
  amount        decimal(15,2) [not null]
  status        transaction_status [not null, default: 'PENDING']
  referenceCode varchar(50) [not null, unique, note: 'mis. TRX-2026-000045']
  description   varchar(255)
  paidAt        datetime
  createdAt     datetime [not null, default: `now()`]

  indexes {
    (userId, createdAt) [name: 'idx_transaction_user']
  }

  Note: '''
    SIMULASI MURNI untuk babak penyisihan. Tanpa SDK Midtrans/Xendit.
    HANYA untuk biaya layanan platform dan langganan Modalin Pro.
    Dana investasi UMKM-investor TIDAK PERNAH lewat tabel ini maupun platform,
    karena berpotensi masuk ranah perizinan Securities Crowdfunding
    (POJK No. 17/2025) atau P2P lending yang diawasi OJK (ARCHITECTURE.md §11).
  '''
}
