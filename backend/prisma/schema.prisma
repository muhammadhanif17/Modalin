// Diturunkan dari specs/modalin-erd.dbml. Jangan edit di sini tanpa mengubah
// dbml-nya lebih dulu — dbml adalah single source of truth (ARCHITECTURE.md §5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUM (8) — lihat catatan penyimpangan #2 di modalin-erd.dbml
// ============================================================================

enum Role {
  UMKM
  INVESTOR
  ADMIN
}

/// Gerbang badge Terverifikasi (FR-02)
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

/// FR-14. PENDING->ACCEPTED/REJECTED hanya oleh receiver; ACCEPTED->CLOSED oleh salah satu pihak.
enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  CLOSED
}

enum FundingStatus {
  DRAFT
  ACTIVE
  NEGOTIATION
  FUNDED
  COMPLETED
  CANCELLED
}

/// Kunci hard filter irisan (FR-06)
enum CooperationType {
  BAGI_HASIL
  PENYERTAAN_MODAL
  PINJAMAN
}

/// Gerbang terbit PDF (FR-10/FR-11)
enum AgreementStatus {
  DRAFT
  WAITING_SIGNATURE
  SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  PLATFORM_FEE
  SUBSCRIPTION_PRO
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

// ============================================================================
// KELOMPOK 1 — IDENTITAS
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(254)
  /// Argon2id, bukan bcrypt (OWASP — ARCHITECTURE.md §4.3)
  passwordHash String   @db.VarChar(255)
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile             Profile?
  business            Business?
  investorPreference  InvestorPreference?
  portfolios          Portfolio[]
  sentConnections     Connection[]         @relation("connectionSender")
  receivedConnections Connection[]         @relation("connectionReceiver")
  closedConnections   Connection[]         @relation("connectionCloser")
  messages            Message[]
  signatures          AgreementSignature[]
  ratingsGiven        Rating[]             @relation("ratingReviewer")
  ratingsReceived     Rating[]             @relation("ratingReviewed")
  transactions        Transaction[]
  verifiedProfiles    Profile[]            @relation("profileVerifier")

  @@index([role])
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  fullName  String  @db.VarChar(120)
  phone     String? @db.VarChar(30)
  avatarUrl String? @db.VarChar(500)
  /// Generik. Untuk INVESTOR dipakai sebagai deskripsi fokus investasi.
  bio       String? @db.Text
  /// Dipakai bobot lokasi 10% (FR-07)
  location  String? @db.VarChar(120)

  // --- FR-02 KYC & verifikasi ---
  ktpUrl             String?            @db.VarChar(500)
  nibUrl             String?            @db.VarChar(500)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  /// Kunci urutan antrean admin — FR-02 mensyaratkan antrean urut waktu unggah
  kycSubmittedAt     DateTime?
  verifiedAt         DateTime?
  verifiedById       String?
  /// Wajib terisi saat REJECTED
  rejectReason       String?            @db.VarChar(500)

  // --- FR-03 Trust Score ---
  trustScore          Int       @default(0)
  trustScoreUpdatedAt DateTime?

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("profileVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([verificationStatus, kycSubmittedAt])
  @@index([trustScore])
}

// ============================================================================
// KELOMPOK 2 — DATA BISNIS DAN INVESTASI
// ============================================================================

model Sector {
  id   String @id @default(cuid())
  name String @unique @db.VarChar(80)
  slug String @unique @db.VarChar(80)

  businesses          Business[]
  investorPreferences InvestorPreference[]
}

model Business {
  id              String   @id @default(cuid())
  ownerId         String   @unique
  name            String   @db.VarChar(150)
  description     String   @db.Text
  sectorId        String
  location        String   @db.VarChar(120)
  establishedYear Int?
  employeeCount   Int?
  monthlyRevenue  Decimal? @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sector          Sector           @relation(fields: [sectorId], references: [id])
  fundingRequests FundingRequest[]

  @@index([sectorId, location])
}

model FundingRequest {
  id               String        @id @default(cuid())
  businessId       String
  title            String        @db.VarChar(150)
  /// Nilai tunggal, bukan rentang min-max (ARCHITECTURE.md §5.2)
  targetAmount     Decimal       @db.Decimal(15, 2)
  purpose          String        @db.Text
  /// Json array of CooperationType. Multi-pilih — sisi UMKM untuk irisan FR-06.
  /// Divalidasi Zod di Application Layer (Prisma/MySQL tidak punya enum array).
  cooperationTypes Json
  tenorMonths      Int?
  estimatedRoi     Decimal?      @db.Decimal(5, 2)
  deadline         DateTime?
  status           FundingStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connections Connection[]

  @@index([status, createdAt])
  @@index([businessId])
}

model InvestorPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  /// Bobot modal 30% (FR-07)
  minimumAmount     Decimal  @default(0) @db.Decimal(15, 2)
  maximumAmount     Decimal  @default(0) @db.Decimal(15, 2)
  /// Bobot lokasi 10% HANYA dihitung kalau kolom ini terisi (FR-07)
  preferredLocation String?  @db.VarChar(120)
  /// Nullable. Ada supaya bobot sektor 40% punya data dari sisi investor juga.
  preferredSectorId String?
  /// Json array of CooperationType — sisi investor untuk irisan FR-06.
  cooperationTypes  Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredSector Sector? @relation(fields: [preferredSectorId], references: [id], onDelete: SetNull)
}

/// Generik untuk kedua peran. UMKM: proposal usaha. Investor: rekam jejak investasi.
model Portfolio {
  id          String   @id @default(cuid())
  ownerId     String
  title       String   @db.VarChar(150)
  description String?  @db.Text
  fileUrl     String   @db.VarChar(500)
  /// MIME. Hanya PDF/gambar (FR-04)
  fileType    String   @db.VarChar(80)
  /// Byte. Ditolak jika > 10 MB (FR-04)
  fileSize    Int
  createdAt   DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

// ============================================================================
// KELOMPOK 3 — INTERAKSI DAN KESEPAKATAN
// ============================================================================

model Connection {
  id               String           @id @default(cuid())
  senderId         String
  receiverId       String
  fundingRequestId String?
  status           ConnectionStatus @default(PENDING)
  message          String?          @db.VarChar(500)
  respondedAt      DateTime?
  closedAt         DateTime?
  /// Siapa yang mengakhiri. CLOSED boleh dilakukan salah satu pihak.
  closedById       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  sender         User            @relation("connectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User            @relation("connectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  closedBy       User?           @relation("connectionCloser", fields: [closedById], references: [id], onDelete: SetNull)
  fundingRequest FundingRequest? @relation(fields: [fundingRequestId], references: [id], onDelete: SetNull)
  conversation   Conversation?
  agreements     Agreement[]

  @@unique([senderId, receiverId, fundingRequestId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

/// Dibuat tepat saat Connection jadi ACCEPTED, tidak sebelumnya.
model Conversation {
  id           String   @id @default(cuid())
  connectionId String   @unique
  createdAt    DateTime @default(now())

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messages   Message[]
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String    @db.Text
  /// NULL = belum dibaca. Sumber indikator in-app notification (FR-09).
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

model Agreement {
  id              String          @id @default(cuid())
  connectionId    String
  agreementNumber String          @unique @db.VarChar(50)
  /// Menentukan template dokumen yang dipakai (FR-10)
  cooperationType CooperationType
  amount          Decimal         @db.Decimal(15, 2)
  startDate       DateTime
  endDate         DateTime?

  // --- Field skema-spesifik. Menutup Keputusan Terbuka ARCHITECTURE.md §12 poin 1. ---
  /// Persen bagian investor. Hanya untuk BAGI_HASIL.
  profitSharingRatio Decimal? @db.Decimal(5, 2)
  /// Persen kepemilikan. Hanya untuk PENYERTAAN_MODAL.
  equityPercentage   Decimal? @db.Decimal(5, 2)
  /// Persen per tahun. Hanya untuk PINJAMAN.
  interestRate       Decimal? @db.Decimal(5, 2)
  tenorMonths        Int?

  terms       String?         @db.Text
  status      AgreementStatus @default(DRAFT)
  /// PDF final. Wajib NULL selama status != SIGNED (FR-10/FR-11).
  documentUrl String?         @db.VarChar(500)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  connection Connection           @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  signatures AgreementSignature[]
  ratings    Rating[]

  @@index([connectionId])
  @@index([status])
}

/// Satu tanda tangan per user per agreement. PDF final hanya terbit kalau ada 2 (FR-10).
/// TIDAK tersertifikasi PSrE — sah per Ps.11 UU ITE & Ps.59(3) PP 71/2019,
/// tapi jangan diklaim setara akta notaris (ARCHITECTURE.md §11).
model AgreementSignature {
  id           String   @id @default(cuid())
  agreementId  String
  userId       String
  signatureUrl String   @db.VarChar(500)
  signedIp     String?  @db.VarChar(45)
  signedAt     DateTime @default(now())

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agreementId, userId])
}

model Rating {
  id             String   @id @default(cuid())
  agreementId    String
  reviewerId     String
  reviewedUserId String
  /// Skala 1-5, divalidasi di Application Layer
  score          Int
  review         String?  @db.Text
  createdAt      DateTime @default(now())

  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  reviewer     User      @relation("ratingReviewer", fields: [reviewerId], references: [id])
  reviewedUser User      @relation("ratingReviewed", fields: [reviewedUserId], references: [id])

  @@unique([agreementId, reviewerId])
  @@index([reviewedUserId])
}

// ============================================================================
// KELOMPOK 4 — PEMBAYARAN (FR-13)
// ============================================================================

/// SIMULASI MURNI, tanpa SDK. Hanya biaya layanan platform & langganan Modalin Pro.
/// Dana investasi UMKM-investor TIDAK PERNAH lewat sini (ARCHITECTURE.md §11).
model Transaction {
  id            String            @id @default(cuid())
  userId        String
  type          TransactionType
  amount        Decimal           @db.Decimal(15, 2)
  status        TransactionStatus @default(PENDING)
  referenceCode String            @unique @db.VarChar(50)
  description   String?           @db.VarChar(255)
  paidAt        DateTime?
  createdAt     DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
